{
  "openapi": "3.1.0",
  "info": {
    "title": "Petstore Plus",
    "version": "1.2.3"
  },
  "servers": [{ "url": "https://api.example.com/v1" }],
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "summary": "List all pets",
        "description": "Returns every pet in the store.",
        "tags": ["pets", "read"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of pets to return.",
            "schema": { "type": "integer", "default": 20 }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/PetStatus" }
          },
          {
            "name": "tags",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": false,
            "schema": { "type": "array", "items": { "type": "string" } }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of pets.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Pet" }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPet",
        "summary": "Create a pet",
        "tags": ["pets", "write"],
        "requestBody": {
          "required": true,
          "description": "The pet to add.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Pet" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created pet.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}": {
      "parameters": [
        {
          "name": "petId",
          "in": "path",
          "required": true,
          "description": "Pet identifier.",
          "schema": { "type": "integer" }
        }
      ],
      "get": {
        "operationId": "getPetById__internal",
        "summary": "Get a pet",
        "tags": ["pets", "read"],
        "responses": {
          "200": {
            "description": "The pet.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replacePet",
        "summary": "Replace a pet",
        "tags": ["pets", "write"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "petId": {
                    "type": "integer",
                    "description": "Pet id in body."
                  },
                  "name": { "type": "string" }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deletePet",
        "tags": ["pets", "write"],
        "responses": {
          "204": { "description": "Deleted." }
        }
      }
    },
    "/pets/{petId}/photos": {
      "get": {
        "summary": "Get pet photos!",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Photo URLs.",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "/owners/{ownerId}/pets/{petId}": {
      "get": {
        "operationId": "getOwnerPet",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          },
          {
            "name": "ownerId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The owner's pet.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "2XX": {
            "description": "Search results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reports": {
      "get": {
        "operationId": "getReport",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "format",
            "in": "header",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The report.",
            "content": {
              "text/plain": { "schema": { "type": "string" } }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "tags": ["orders"],
        "requestBody": {
          "required": true,
          "description": "Order to place.",
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/OrderBase" },
                  { "$ref": "#/components/schemas/OrderExtra" }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Placed order.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          }
        }
      }
    },
    "/shapes": {
      "post": {
        "operationId": "createShape",
        "tags": ["shapes"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Shape" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The shape.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Shape" }
              }
            }
          }
        }
      }
    },
    "/notes": {
      "post": {
        "operationId": "createNote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "string", "title": "Note Text" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The stored note.",
            "content": {
              "text/plain": { "schema": { "type": "string" } }
            }
          }
        }
      }
    },
    "/upload": {
      "post": {
        "operationId": "uploadFile",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "description": { "type": "string" }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "id": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "/audits": {
      "post": {
        "operationId": "generatePetInventoryAuditReportForVeterinaryComplianceReview",
        "responses": {
          "200": {
            "description": "Audit report.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "ok": { "type": "boolean" } }
                }
              }
            }
          }
        }
      }
    },
    "/dup-a": {
      "get": {
        "operationId": "duplicate name",
        "responses": {
          "200": {
            "description": "First duplicate.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": {} }
              }
            }
          }
        }
      }
    },
    "/dup-b": {
      "get": {
        "operationId": "duplicate-name",
        "responses": {
          "200": {
            "description": "Second duplicate.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": {} }
              }
            }
          }
        }
      }
    },
    "/headers-test": {
      "get": {
        "operationId": "headersTest",
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "session",
            "in": "cookie",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Echo.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "ok": { "type": "boolean" } }
                }
              }
            }
          }
        }
      }
    },
    "/filter": {
      "get": {
        "operationId": "filterItems",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "schema": {
              "type": "object",
              "properties": {
                "color": { "type": "string" },
                "size": { "type": "integer" }
              }
            }
          },
          {
            "name": "ids",
            "in": "query",
            "style": "spaceDelimited",
            "explode": false,
            "schema": { "type": "array", "items": { "type": "integer" } }
          },
          {
            "name": "codes",
            "in": "query",
            "style": "pipeDelimited",
            "explode": false,
            "schema": { "type": "array", "items": { "type": "string" } }
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered items.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "/content-param": {
      "get": {
        "operationId": "contentParam",
        "parameters": [
          {
            "name": "payload",
            "in": "query",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Category" }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Echoed payload.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Category" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "category": { "$ref": "#/components/schemas/Category" },
          "status": { "$ref": "#/components/schemas/PetStatus" }
        },
        "required": ["id", "name"]
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        }
      },
      "PetStatus": {
        "type": "string",
        "enum": ["available", "pending", "sold"]
      },
      "OrderBase": {
        "type": "object",
        "properties": {
          "sku": { "type": "string" },
          "quantity": { "type": "integer" }
        },
        "required": ["sku"]
      },
      "OrderExtra": {
        "type": "object",
        "properties": {
          "note": { "type": "string" },
          "quantity": { "type": "integer" }
        },
        "required": ["quantity"]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "sku": { "type": "string" },
          "quantity": { "type": "integer" }
        }
      },
      "Shape": {
        "type": "object",
        "properties": {
          "kind": { "type": "string" },
          "label": { "type": "string" }
        },
        "required": ["kind"],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "circle": "#/components/schemas/Circle",
            "square": "Square"
          }
        }
      },
      "Circle": {
        "type": "object",
        "properties": {
          "kind": { "type": "string" },
          "radius": { "type": "number" },
          "area": { "type": "number" }
        }
      },
      "Square": {
        "allOf": [
          { "$ref": "#/components/schemas/Shape" },
          {
            "type": "object",
            "properties": {
              "side": { "type": "number" },
              "area": { "type": "integer" }
            }
          }
        ]
      },
      "Unused": {
        "type": "object",
        "properties": { "never": { "type": "string" } }
      }
    }
  }
}
