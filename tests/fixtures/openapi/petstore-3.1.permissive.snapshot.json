    {
      "name": "createShape",
      "description": "Executes POST /shapes",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "Selects the variant. Accepted values: 'circle', 'square'. 'circle' uses radius, area; 'square' uses side, area. Send only the fields belonging to the selected variant."
          },
          "label": {
            "type": "string"
          },
          "radius": {
            "type": "number"
          },
          "area": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              }
            ]
          },
          "side": {
            "type": "number"
          }
        },
        "required": [
          "kind"
        ],
        "$defs": {
          "Circle": {
            "properties": {
              "kind": {
                "type": "string"
              },
              "radius": {
                "type": "number"
              },
              "area": {
                "type": "number"
              }
            },
            "type": "object"
          },
          "Square": {
            "allOf": [
              {
                "$ref": "#/$defs/Shape"
              },
              {
                "properties": {
                  "side": {
                    "type": "number"
                  },
                  "area": {
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            ]
          },
          "Shape": {
            "properties": {
              "kind": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "type": "object",
            "required": [
              "kind"
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "tags": [
        "shapes"
      ]
    },
