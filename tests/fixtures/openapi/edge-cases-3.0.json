{
  "openapi": "3.0.3",
  "info": {
    "title": "Edge Cases",
    "version": "0.1.0"
  },
  "servers": [{ "url": "https://edge.example.com" }],
  "paths": {
    "/widgets": {
      "get": {
        "operationId": "listWidgets",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true,
              "enum": ["a", "b"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "All widgets.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Widget" }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createWidget",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Widget" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The widget.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Widget" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Widget": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "readOnly": true },
          "name": { "type": "string", "nullable": true },
          "secret": { "type": "string", "writeOnly": true },
          "meta": {
            "nullable": true,
            "oneOf": [
              { "$ref": "#/components/schemas/MetaA" },
              { "$ref": "#/components/schemas/MetaB" }
            ]
          },
          "labels": {
            "type": "array",
            "items": { "type": "string", "nullable": true },
            "xml": { "name": "labels" }
          }
        },
        "required": ["name"]
      },
      "MetaA": {
        "type": "object",
        "properties": { "a": { "type": "string" } }
      },
      "MetaB": {
        "type": "object",
        "properties": { "b": { "type": "integer" } }
      }
    }
  }
}
